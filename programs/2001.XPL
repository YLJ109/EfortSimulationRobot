<?xml version="1.0" encoding="utf-8"?>
<!--Date(ymd)/time(hms) 2026/09/24 13:45:00-->
<Xpl-source>
  <HostEnvironment>
    <Config>
      <FileId>0x58967834</FileId>
      <Target>Robox Motion Control</Target>
      <XplType>RoboticProgramLanguage</XplType>
    </Config>
  </HostEnvironment>
  <XplEnvironment>
    <Info>
      <Title LcId="1033"><![CDATA[XPL program]]></Title>
      <Description LcId="1033"><![CDATA[XPL program edited from IDE]]></Description>
      <Version>1.0.0</Version>
      <Author>Robox SpA</Author>
    </Info>
    <VarDeclarations>
      <VarExtern/>
      <VarGlobal/>
    </VarDeclarations>
    <Pous>
      <Pou>
        <Name>Main</Name>
        <Type>Program</Type>
        <VarDeclarations/>
        <Body>
          <while>
            <cond>true</cond>
            <pouref>1</pouref>
          </while>
          <end_pro/>
        </Body>
        <Pou>
          <Name>1</Name>
          <Body>
            <rem>
              <text>---------- ① 吸气服务：等 40135.Bit1 ----------</text>
            </rem>
            <set>
              <dest>fidbus.mtcp_wo_b[1]</dest>
              <expr>false</expr>
            </set>
            <wait>
              <condition>fidbus.mtcp_ro_b[1]</condition>
              <timeout></timeout>
              <var></var>
            </wait>
            <set>
              <dest>io.DOut[8]</dest>
              <expr>true</expr>
            </set>
            <dwell>
              <expr>0.30</expr>
            </dwell>
            <set>
              <dest>fidbus.mtcp_wo_b[1]</dest>
              <expr>true</expr>
            </set>
            <wait>
              <condition>!fidbus.mtcp_ro_b[1]</condition>
              <timeout></timeout>
              <var></var>
            </wait>
            <rem>
              <text>---------- ② 放气服务：等 40135.Bit2 ----------</text>
            </rem>
            <set>
              <dest>fidbus.mtcp_wo_b[2]</dest>
              <expr>false</expr>
            </set>
            <wait>
              <condition>fidbus.mtcp_ro_b[2]</condition>
              <timeout></timeout>
              <var></var>
            </wait>
            <set>
              <dest>io.DOut[8]</dest>
              <expr>false</expr>
            </set>
            <dwell>
              <expr>0.30</expr>
            </dwell>
            <set>
              <dest>io.DOut[9]</dest>
              <expr>true</expr>
            </set>
            <dwell>
              <expr>0.40</expr>
            </dwell>
            <set>
              <dest>io.DOut[9]</dest>
              <expr>false</expr>
            </set>
            <dwell>
              <expr>0.10</expr>
            </dwell>
            <set>
              <dest>fidbus.mtcp_wo_b[2]</dest>
              <expr>true</expr>
            </set>
            <wait>
              <condition>!fidbus.mtcp_ro_b[2]</condition>
              <timeout></timeout>
              <var></var>
            </wait>
            <rem>
              <text>---------- ③ 点动服务：等 40135.Bit0（测吸气/放气时切勿触发） ----------</text>
            </rem>
            <set>
              <dest>fidbus.mtcp_wo_b[0]</dest>
              <expr>false</expr>
            </set>
            <wait>
              <condition>fidbus.mtcp_ro_b[0]</condition>
              <timeout></timeout>
              <var></var>
            </wait>
            <mjoint>
              <target>POINTJ(fidbus.mtcp_ro_i[0]/100.0,fidbus.mtcp_ro_i[1]/100.0,fidbus.mtcp_ro_i[2]/100.0,fidbus.mtcp_ro_i[3]/100.0,fidbus.mtcp_ro_i[4]/100.0,fidbus.mtcp_ro_i[5]/100.0)</target>
              <speed>v5perc</speed>
              <zone>fine</zone>
              <tool>tool0</tool>
              <refsys></refsys>
            </mjoint>
            <set>
              <dest>fidbus.mtcp_wo_b[0]</dest>
              <expr>true</expr>
            </set>
            <wait>
              <condition>!fidbus.mtcp_ro_b[0]</condition>
              <timeout></timeout>
              <var></var>
            </wait>
          </Body>
        </Pou>
      </Pou>
    </Pous>
  </XplEnvironment>
</Xpl-source>
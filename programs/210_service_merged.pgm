(* ================================================================
   程序号 : 210   ——  控制器上唯一常驻服务程序（点动 + 四路气路）
   版本   : v4.0   2026-09-29
   ----------------------------------------------------------------
   ① 点动      40135.Bit0  → MJOINT(v100perc)     完成位 40035.Bit0
   ② 吸        40135.Bit1  → io.DOut[N] := true   完成位 40035.Bit1   （保持）
   ③ 停止吸    40135.Bit2  → io.DOut[N] := false  完成位 40035.Bit2
   ④ 放        40135.Bit3  → io.DOut[M] := true   完成位 40035.Bit3   （保持）
   ⑤ 停止放    40135.Bit4  → io.DOut[M] := false  完成位 40035.Bit4

   ----------------------------------------------------------------
   ★★ 速度常量必须是 v100perc（不是 v50perc）—— 这是"速度显示不一致"的根治点：
      有效速度 = 程序内 v…perc × 40103。
      用 v50perc 时，上位机为了"右上角 = 实际速度"要把 40103 写成本身的 2 倍
      （设 17% → 写 34%），于是**示教器速度显示 34%、右上角 17%、你设的又不一样**。
      改成 v100perc 后：有效速度 = 100% × 40103 = 40103 →
      **上位机写多少、示教器显示多少、机器人走多少，三者完全一致**，反算逻辑自动失效。
      ★ 同时要把 config/robot.yaml 的 motion.jog.service_program_vperc 改成 100。
   ★ N = 真空阀输出号（参考项目 8）；M = 吹气阀输出号（参考项目 9）。
     **两者都必须以示教器 IO 监控实测为准** —— 程序不读回 DO，
     写错号时上位机照样报"完成"而阀根本没动。
   ★ 四路气路都是**电平保持**（置位后一直保持，直到显式停止）：
     吸 → 一直吸，靠 ③ 停止吸；放 → 一直吹，靠 ⑤ 停止放。
     为什么不自动停：吸自动停会让工件中途掉；吹自动停则吹不动大件。
     想"吹一下就收"的场合，在上位机序列里排 [放, 等待 0.4s, 停止放] 即可。
   ★ 配套 .var 文件留空即可（本程序不声明自定义变量）。

   ----------------------------------------------------------------
   ★★ 取反一律写 NOT（RPL 文本语法），不要写 ! ——
      ! 只是示教器把程序导出成 .XPL 时对 <condition> 的规范化写法。
      见 docs/规范-RPL程序编写规范与200服务程序.md 铁律 4。
   ★★ 为什么这些服务必须是**同一个程序**：
      控制器同一时刻只能"加载并运行一个程序"。拆号 → 每按一次按钮都要
      「停当前程序 → 加载另一个号 → 运行」= 反复报 5005 + 切换竞态。
   ★★ 完成位为什么「循环顶 + 块内」两处都清 0（竞态修复，不能删）：
      上位机逻辑 = 「置触发 → 轮询自己那条完成位 → 撤触发」。完成位若残留 1，
      上位机会在第一次轮询就误判"已完成"并立刻撤触发 → 对应分支永不执行
      （症状：第二次按吸气/点动没反应）。
        · 循环顶清 → 空闲期恒 0，上位机置触发后第一次轮询必读到 0；
                     同时对付"程序被 CMD_STOP 打断在块内"留下的残留 1。
        · 块内清   → 与已验证可用的 200 写法一致，块自身完整可读。
   ★★ 位分配（铁律 3：一个位只干一件事，禁止复用）：
      40135/40035 的 Bit0 点动 / Bit1 吸 / Bit2 停止吸 / Bit3 放 / Bit4 停止放。
      今后再加服务，往下取 Bit5……
   ================================================================ *)

WHILE true DO

    (* ---------- 完成位复位（循环顶；见上方说明，勿删） ---------- *)
    fidbus.mtcp_wo_b[0] := false;        (* 点动完成位   40035.Bit0 *)
    fidbus.mtcp_wo_b[1] := false;        (* 吸完成位     40035.Bit1 *)
    fidbus.mtcp_wo_b[2] := false;        (* 停止吸完成位 40035.Bit2 *)
    fidbus.mtcp_wo_b[3] := false;        (* 放完成位     40035.Bit3 *)
    fidbus.mtcp_wo_b[4] := false;        (* 停止放完成位 40035.Bit4 *)

    (* ---------- ① 点动服务：等 40135.Bit0 ---------- *)
    WHILE fidbus.mtcp_ro_b[0] DO
        fidbus.mtcp_wo_b[0] := false;
        MJOINT(POINTJ(fidbus.mtcp_ro_i[0]/100.0,
                      fidbus.mtcp_ro_i[1]/100.0,
                      fidbus.mtcp_ro_i[2]/100.0,
                      fidbus.mtcp_ro_i[3]/100.0,
                      fidbus.mtcp_ro_i[4]/100.0,
                      fidbus.mtcp_ro_i[5]/100.0), v100perc, fine, tool0);
        fidbus.mtcp_wo_b[0] := true;
        WAIT(NOT fidbus.mtcp_ro_b[0]);
        fidbus.mtcp_wo_b[0] := false;
    END_WHILE;

    (* ---------- ② 吸：等 40135.Bit1（电平保持，不自动停） ---------- *)
    WHILE fidbus.mtcp_ro_b[1] DO
        fidbus.mtcp_wo_b[1] := false;
        io.DOut[8] := true;              (* ★ N=8 真空阀，以现场 IO 实测为准 *)
        fidbus.mtcp_wo_b[1] := true;
        WAIT(NOT fidbus.mtcp_ro_b[1]);
        fidbus.mtcp_wo_b[1] := false;
    END_WHILE;

    (* ---------- ③ 停止吸：等 40135.Bit2（关真空阀） ---------- *)
    WHILE fidbus.mtcp_ro_b[2] DO
        fidbus.mtcp_wo_b[2] := false;
        io.DOut[8] := false;             (* ★ N 同 ② *)
        fidbus.mtcp_wo_b[2] := true;
        WAIT(NOT fidbus.mtcp_ro_b[2]);
        fidbus.mtcp_wo_b[2] := false;
    END_WHILE;

    (* ---------- ④ 放：等 40135.Bit3（开吹气阀，电平保持） ---------- *)
    WHILE fidbus.mtcp_ro_b[3] DO
        fidbus.mtcp_wo_b[3] := false;
        io.DOut[9] := true;              (* ★ M=9 吹气阀，以现场 IO 实测为准 *)
        fidbus.mtcp_wo_b[3] := true;
        WAIT(NOT fidbus.mtcp_ro_b[3]);
        fidbus.mtcp_wo_b[3] := false;
    END_WHILE;

    (* ---------- ⑤ 停止放：等 40135.Bit4（关吹气阀） ---------- *)
    WHILE fidbus.mtcp_ro_b[4] DO
        fidbus.mtcp_wo_b[4] := false;
        io.DOut[9] := false;             (* ★ M 同 ④ *)
        fidbus.mtcp_wo_b[4] := true;
        WAIT(NOT fidbus.mtcp_ro_b[4]);
        fidbus.mtcp_wo_b[4] := false;
    END_WHILE;

    DWELL(0.02);

END_WHILE;

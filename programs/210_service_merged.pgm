(* ================================================================
   程序号 : 210   ——  控制器上唯一常驻服务程序（三合一）
   版本   : v2.3（保持版 · NOT 写法）  2026-09-29
   ----------------------------------------------------------------
   ① 点动     40135.Bit0  → MJOINT(v50perc)         完成位 40035.Bit0
   ② 吸气     40135.Bit1  → io.DOut[N] := true      完成位 40035.Bit1
                            （电平保持：不自动停，须显式 ③ 关断）
   ③ 停止吸气 40135.Bit2  → io.DOut[N] := false     完成位 40035.Bit2

   ★ N = 真空电磁阀实际输出号。DOut[8] 是参考项目 CARRY.XPL 的接法，
     本机以现场 IO 监控实测为准 —— 改 ②③ 两处 io.DOut[N] 的 N 即可。
   ★ 配套 .var 文件留空即可（本程序不声明自定义变量）。
   ★★ 取反一律写 NOT（RPL 文本语法），不要写 ! ——
      ! 只是示教器把程序导出成 .XPL 时对 <condition> 的规范化写法，
      文本源码里照抄 ! 不是规范写法。见 docs/规范-RPL程序编写规范与200服务程序.md 铁律 4。

   ★★ 为什么点动和吸放必须是同一个程序：
      控制器同一时刻只能"加载并运行一个程序"。拆成两个号（200 点动 / 210 吸放）后，
      每按一次网页按钮都要「停当前程序 → 加载另一个号 → 运行」，来回切 = 反复报
      5005 + 切换竞态。合到 210 一个程序后零切换。
   ★★ 吸气为什么是"保持"而不是"0.5s 自动停"：
      0.5s 脉冲会让阀在 0.5 秒后自己松手 → 工件脱落。改为保持后吸气一直 ON，
      直到网页按「停止吸气」（40135.Bit2）才关断。
   ★★ 完成位为什么「循环顶 + 块内」两处都清 0（竞态修复，不能删）：
      上位机逻辑 = 「置触发 → 轮询自己那条完成位 → 撤触发」。若完成位残留上一轮的 1，
      上位机会在第一次轮询就误判"已完成"并立刻撤触发，对应分支就永远不执行
      （症状：第二次按吸气/点动没反应）。
        · 循环顶清 → 保证**空闲期恒为 0**，上位机置触发后第一次轮询读到的一定是 0；
                     同时对付"程序被 CMD_STOP 打断在块内"留下的残留 1。
        · 块内清   → 与已验证可用的 200 写法一致，块自身完整、可单独阅读。
   ================================================================ *)

WHILE true DO

    (* ---------- 完成位复位（循环顶；见上方说明，勿删） ---------- *)
    fidbus.mtcp_wo_b[0] := false;        (* 点动完成位     40035.Bit0 *)
    fidbus.mtcp_wo_b[1] := false;        (* 吸气完成位     40035.Bit1 *)
    fidbus.mtcp_wo_b[2] := false;        (* 停止吸气完成位 40035.Bit2 *)

    (* ---------- ① 点动服务：等 40135.Bit0 ---------- *)
    WHILE fidbus.mtcp_ro_b[0] DO
        fidbus.mtcp_wo_b[0] := false;
        MJOINT(POINTJ(fidbus.mtcp_ro_i[0]/100.0,
                      fidbus.mtcp_ro_i[1]/100.0,
                      fidbus.mtcp_ro_i[2]/100.0,
                      fidbus.mtcp_ro_i[3]/100.0,
                      fidbus.mtcp_ro_i[4]/100.0,
                      fidbus.mtcp_ro_i[5]/100.0), v50perc, fine, tool0);
        fidbus.mtcp_wo_b[0] := true;
        WAIT(NOT fidbus.mtcp_ro_b[0]);
        fidbus.mtcp_wo_b[0] := false;
    END_WHILE;

    (* ---------- ② 吸气：等 40135.Bit1（电平保持，不自动停） ---------- *)
    WHILE fidbus.mtcp_ro_b[1] DO
        fidbus.mtcp_wo_b[1] := false;
        io.DOut[8] := true;              (* ★ N=8，以现场 IO 实测为准 *)
        fidbus.mtcp_wo_b[1] := true;
        WAIT(NOT fidbus.mtcp_ro_b[1]);
        fidbus.mtcp_wo_b[1] := false;
    END_WHILE;

    (* ---------- ③ 停止吸气：等 40135.Bit2（立即关断真空） ---------- *)
    WHILE fidbus.mtcp_ro_b[2] DO
        fidbus.mtcp_wo_b[2] := false;
        io.DOut[8] := false;             (* ★ N 同 ② *)
        fidbus.mtcp_wo_b[2] := true;
        WAIT(NOT fidbus.mtcp_ro_b[2]);
        fidbus.mtcp_wo_b[2] := false;
    END_WHILE;

    DWELL(0.02);

END_WHILE;

# =====================================================================
#  EFORT Web Monitoring - 环境变量模板
#  用法: 复制本文件为 .env (放在项目根目录), 按需改值。
#        后端启动时自动读取 .env; 已存在的系统环境变量优先, 不会被覆盖。
#        不建 .env 也能跑 —— 所有项都有内置默认值。
# =====================================================================

# ---- 后端 ----

# 模拟模式: auto = 连不上机器人自动回退模拟轨迹(默认)
#           always = 强制模拟(无机器人也能演示)
#           never  = 强制真机, 连不上就报错
EFORT_SIMULATE=auto

# 覆盖数据库位置(SQLAlchemy URL)。留空则用 config/robot.yaml 的 data/robot.db
# 例: EFORT_DB_URL=sqlite:///D:/EFORT_Projects/EFORT_Web_Monitoring/data/robot.db
# EFORT_DB_URL=

# ---- 控制权限（阶段 1，必设！）----
# 管理员密码：连接真机执行 / 急停前需此密码换取限时控制令牌(X-Control-Token)。
# 未设置时每次启动生成随机临时密码并打印到日志（无人可用，仅防误开控制门）。
EFORT_ADMIN_PASSWORD=change-me-to-a-strong-password

# 操作员密码（阶段 4 角色，选填）
# 只能操控机器人(下发/急停)，改不了安全围栏配置、导不了备份、清不了审计日志。
# 留空 = 不启用操作员角色，所有令牌都是管理员权限（与阶段 1 行为一致）。
# EFORT_OPERATOR_PASSWORD=

# 围栏互锁严格模式对应的开关在 config/robot.yaml: motion.require_live_safety
# true  = 前端没实时上报围栏状态(或状态已过期)时，服务端拒绝下发运动
# false = 放行但记一条 "control.interlock_absent" 告警事件（默认，兼容纯脚本调用）

# 控制令牌有效期（秒，默认 1800 = 30 分钟）
EFORT_CONTROL_TTL=1800

# ---- 执行引擎真实下发（阶段 2，默认关闭！）----
# 真实下发给控制器需双确认，否则只做校验 + 记录(模拟)，避免误动作：
#   1) 本变量 = 1   2) config/robot.yaml 的 motion.real_write = true
# 写寄存器地址务必按控制器手册核对后再开启。
# EFORT_REAL_MOTION=0

# ---- 视觉检测服务 (camera/camera_service.py, 端口 8100) ----

# 服务端口
CAMERA_PORT=8100

# MVS 相机 SDK 的 Python 封装目录 (内含 MvCameraControl_class.py)
# 留空则用内置默认: D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\src\sdk\MvImport
# EFORT_MVS_SDK_DIR=D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\src\sdk\MvImport

# MVS 运行时 DLL 目录 (海康 MVS 客户端安装自带)
# 留空则用内置默认: C:\Program Files (x86)\Common Files\MVS\Runtime\Win64_x64
# EFORT_MVS_RUNTIME_DIR=C:\Program Files (x86)\Common Files\MVS\Runtime\Win64_x64

# 跑视觉服务的 Python 解释器 (需含 torch / ultralytics / MVS 封装)
# 留空则用内置默认: D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\venv\Scripts\python.exe
# EFORT_CAMERA_PYTHON=D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\venv\Scripts\python.exe

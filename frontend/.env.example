# =====================================================================
#  前端构建期变量模板 (Vite)
#  用法: 复制为 frontend/.env 后按需修改; 改动后需重新 `npm run build`。
#  仅 VITE_ 前缀的变量会注入到浏览器代码中。
# =====================================================================

# 视觉检测服务端口 (独立进程, 默认 8100)
# 与根目录 .env 的 CAMERA_PORT 保持一致即可。
VITE_CAMERA_PORT=8100
